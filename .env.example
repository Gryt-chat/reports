# Where the database goes. Every report ever sent lives here — mount it.
DATA_DIR=./data
HOST=0.0.0.0
# One port. Reports come in here and the inbox is at /admin behind sign-in.
PORT=8080

# One key per app, sent as X-Gryt-App-Key. Empty on the deployment behind
# reports.gryt.chat, and worth understanding before turning it on: a key that
# ships inside a public app is not a secret, and the day it needs rotating is
# the day everybody who has not updated stops being able to report a bug.
# What it does buy is that a scanner which stumbles onto this endpoint gets
# nowhere. Generate with: openssl rand -hex 32
REPORTS_APP_KEYS=

# Take reports with no app key at all. The service refuses to start without
# either this or REPORTS_APP_KEYS, because the endpoint is public.
#
# Note that this and REPORTS_APP_KEYS are not additive: with keys configured,
# an app id that is not among them is refused whatever this says. To take
# unkeyed reports, leave REPORTS_APP_KEYS empty.
REPORTS_ALLOW_UNKEYED=true

# Refuse anything not signed with a Gryt identity key. Off until every client
# sends one; the endpoint shape is the same either way.
REPORTS_REQUIRE_SIGNATURE=false

# Browser origins allowed to POST, and now enforced rather than only answered
# with. A request carrying an Origin that is not on this list is refused.
#
# Only browsers send an Origin, so this cannot be a list every client has to
# match: the mobile app sends none and neither does Electron's main process.
# What it stops is a page on the open web making somebody's browser file
# reports — CORS already stops that page reading the answer, but without this
# the report still lands in the table.
REPORTS_CORS_ORIGINS=https://app.gryt.chat,https://beta.gryt.chat

# Read the client address from cf-connecting-ip / x-forwarded-for.
REPORTS_TRUST_PROXY=true

# And believe it only from these addresses. The ingest port is published on the
# machine's network address, so the proxy is not the only thing that can reach
# it — and anything else that can will send cf-connecting-ip and opt itself out
# of every per-address rate limit and every ban. Empty means believe any peer,
# which is only right when nothing but the proxy can reach the port.
REPORTS_TRUSTED_PROXIES=

# The inbox at /admin. No token, no inbox.
# Generate with: openssl rand -hex 32
REPORTS_ADMIN_TOKEN=
REPORTS_PUBLIC_URL=https://reports.gryt.chat

# The shortest gap between one client's reports, in seconds. The cheapest
# thing here and the one that does the most: a script posting in a loop is
# stopped by its second request, before any hourly counter has noticed. Set 0
# to turn it off.
REPORTS_MIN_INTERVAL_SEC=10

# Rate limits, counted per IP, per install and per identity key.
REPORTS_LIMIT_PER_MINUTE=3
REPORTS_LIMIT_PER_HOUR_PER_IP=10
REPORTS_LIMIT_PER_HOUR_PER_INSTALL=10
REPORTS_LIMIT_PER_DAY_PER_IP=40

# The triage pass. It sorts and never deletes, and without either of the two
# below it does nothing at all — reports arrive unsorted, which still works.
#
# Two providers. A URL picks Ollama, a key picks the API, and naming one wins
# over both — which is how you point them at the same report and compare.
REPORTS_TRIAGE_PROVIDER=

# On the machine. The model has to be reachable from wherever this container
# runs, so this is rarely localhost: bind Ollama to 0.0.0.0 and put its address
# here. Ollama has no authentication, so what can reach it is the whole of who
# can use it.
REPORTS_OLLAMA_URL=
# qwen3:8b is about 5GB at Q4 and shares a 12GB card comfortably. qwen3:14b
# judges better and leaves much less room for anything else on the GPU.
REPORTS_TRIAGE_MODEL=
# How long the weights stay resident after a report. Longer is faster and holds
# VRAM the whole time.
REPORTS_OLLAMA_KEEP_ALIVE=5m
# Generous, because a local card may be busy and nothing waits on triage.
REPORTS_TRIAGE_TIMEOUT_MS=120000

# Through the API instead.
ANTHROPIC_API_KEY=

REPORTS_TRIAGE_ENABLED=
REPORTS_TRIAGE_POLL_MS=15000
REPORTS_TRIAGE_BATCH=5

# Where a new report gets announced. receive | triage | never
REPORTS_DISCORD_WEBHOOK_URL=
REPORTS_NOTIFY_ON=triage

# Ban whoever keeps sending junk, decided by the triage pass.
#
# Only the "noise" verdict counts — empty submissions, test posts, spam,
# nothing to do with Gryt. "not_a_bug" deliberately does not: it means a
# feature request or a support question, and somebody who sends three of those
# is the most engaged person using Gryt rather than an abuser.
#
# The ban is on the identity thumbprint where there is one and the address
# otherwise, and it expires. Set the threshold to 0 to turn it off.
REPORTS_AUTO_BAN_NOISE=3
REPORTS_AUTO_BAN_WINDOW_H=24
REPORTS_AUTO_BAN_DAYS=7

# How long a report keeps the address, install id and user-agent that say who
# sent it. They are there to stop one person flooding the inbox, and everything
# that reads them works over hours or days — the widest window is the auto-ban
# one above. After that they are a list of addresses nobody has a use for, so
# they are nulled out and the report itself is left alone. Set 0 to keep them
# for as long as the report exists, which is what this did before the setting.
REPORTS_RETAIN_IDENTIFIER_DAYS=30

# Filing a report as a task on the Gryt board.
#
# Without a token the Create task button is not offered, because an inbox that
# shows a button which cannot work is worse than one that does not show it.
# The token is a write credential for the board, so it belongs here and nowhere
# in the repository.
REPORTS_VIKUNJA_URL=https://tasks.sivert.io
REPORTS_VIKUNJA_TOKEN=
REPORTS_VIKUNJA_PROJECT=2
# The weekly digest. Nothing else tells anybody a report arrived.
#
# SMTP comes from the GRYT_SMTP_* set the rest of Gryt already uses, rather
# than a second copy to keep in step. Without a host the digest does not run
# and the service starts as normal — it is an addition, not a dependency.
#
# Recipients are the admin allowlist. Somebody with no verified address is
# skipped rather than guessed at, and each gets their own message: the
# allowlist is a list of people who can read the inbox, not a list they have
# agreed to be shown to each other.
#
# DAY is 0 = Sunday. HOUR is on the service's own clock.
REPORTS_DIGEST_ENABLED=true
REPORTS_DIGEST_DAY=1
REPORTS_DIGEST_HOUR=9

GRYT_SMTP_HOST=
GRYT_SMTP_PORT=587
GRYT_SMTP_USER=
GRYT_SMTP_PASS=
GRYT_SMTP_FROM=hello@gryt.chat
GRYT_SMTP_FROM_NAME=Gryt
GRYT_SMTP_REPLY_TO=hello@gryt.chat
